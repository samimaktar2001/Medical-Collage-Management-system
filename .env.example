APP_ORIGIN=http://localhost:3000
API_PORT=4000
# Internal API URL for server-side rendering (defaults to http://127.0.0.1:4000).
# Set this in containerized/serverless deployments where the API is not on localhost.
# API_INTERNAL_URL=http://api-service:4000
# Omit DATABASE_URL for disk-backed embedded PostgreSQL development.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/medical_college
DATA_DIR=.data/postgres
DEMO_MODE=true
# Production is intentionally blocked until identity/MFA and deployment review.
