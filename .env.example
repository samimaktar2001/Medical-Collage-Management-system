# ==============================================================================
# MEDORA MEDICAL COLLEGE MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: NEVER commit real credentials, passwords, or private keys to git.
# In production (Railway / Vercel), set these in the platform Environment Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
# In Railway, PORT is provided automatically. In development, fallback is 4000.
PORT=4000
API_PORT=4000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. CORS & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Frontend origin(s) allowed to access the API. Comma-separated if multiple.
# Example: https://medora-college.vercel.app,https://app.medora.edu.in
APP_ORIGIN=https://your-frontend-app.vercel.app

# Next.js Internal Rewrite Target (Used by Next.js rewrites in apps/web)
# Points from Vercel to your deployed Railway backend API.
# Example: https://medora-api.up.railway.app
API_INTERNAL_URL=https://your-railway-api.up.railway.app
NEXT_PUBLIC_API_URL=https://your-railway-api.up.railway.app

# Cookie SameSite setting ('lax' for same-site or custom domain, 'none' for cross-domain HTTPS)
COOKIE_SAME_SITE=none

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Production connection string with connection pooling (Transaction mode port 6543)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.your-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 4. SUPABASE STORAGE (S3-COMPATIBLE OBJECT STORAGE)
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Project Settings -> Storage -> S3 Credentials
S3_REGION=ap-south-1
S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
S3_BUCKET=medora-documents
S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL CONFIGURATION (OTP, Verification, Notices)
# ------------------------------------------------------------------------------
# Gmail SMTP / SendGrid / AWS SES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_verified_sender@gmail.com
# Use Google App Password (not your personal Google account password)
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="Medora Medical College" <noreply@medora.edu.in>

# ------------------------------------------------------------------------------
# 6. SECURITY & DEMO FLAGS (MANDATORY FALSE IN PRODUCTION)
# ------------------------------------------------------------------------------
ENABLE_DEMO_LOGIN=false
DEMO_MODE=false
DEFAULT_INSTITUTION_ID=demo