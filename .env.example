APP_ORIGIN=http://localhost:3000
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
DEMO_MODE=false

DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# ─── SMTP Email Service Configuration ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="Medical College <noreply@medora.edu>"

# ─── Cloud Document & Media Storage (Supabase / AWS S3) ───
S3_REGION=auto
S3_ENDPOINT=https://[YOUR_PROJECT_ID].supabase.co/storage/v1/s3
S3_BUCKET=medora-documents
S3_ACCESS_KEY_ID=your_supabase_s3_access_key
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_key
S3_FORCE_PATH_STYLE=true